# Core Supabase configuration (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe subscriptions (server-side secrets must never use NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_FREE_PRICE_ID=price_replace_me
STRIPE_STARTER_PRICE_ID=price_replace_me
STRIPE_GROWTH_PRICE_ID=price_replace_me
STRIPE_SCALE_PRICE_ID=price_replace_me

# Transactional email
EMAIL_PROVIDER=manual
EMAIL_FROM=noreply@your-domain.example
RESEND_API_KEY=

# Custom domains, monitoring, and scheduled jobs
CUSTOM_DOMAIN_TARGET=app.your-domain.example
ERROR_TRACKING_DSN=
NEXT_PUBLIC_ERROR_TRACKING_DSN=
CRON_SECRET=replace-with-a-long-random-secret
